#BSUB -J wave_128_4mpi_1omp
#BSUB -W 00:15
#BSUB -o "run_128_4_1.%J.out"
#BSUB -e "run_128_4_1.%J.err"
#BSUB -n 4                       # 保持不变：4 个 MPI 进程
#BSUB -R "span[ptile=4]"         # 保持不变：4 个进程放一个节点
#BSUB -R "affinity[core(1)]"     # 【修改1】：改为 1，每个进程只占 1 个核心

# 设置线程数为 1
export OMP_NUM_THREADS=1         # 【修改2】：改为 1

# 运行命令
mpiexec ./wave_hybrid 128 20
